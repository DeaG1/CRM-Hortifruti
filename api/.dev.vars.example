# Copie para .dev.vars e preencha com os valores reais do projeto Supabase.
# ?sslmode=require e OBRIGATORIO em producao: sem TLS, credenciais, tokens de
# sessao, CNPJ e limites de credito do cliente atravessam a internet publica
# em texto claro entre Cloudflare e Supabase. criarPool (api/src/db.ts) ja
# forca TLS para qualquer host que nao seja localhost/127.0.0.1 mesmo sem
# este parametro — mas a URL deve trazer o parametro do mesmo jeito, nao
# dependa so do codigo.
DATABASE_URL=postgres://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?sslmode=require
